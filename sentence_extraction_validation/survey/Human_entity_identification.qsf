container.\", topLabels.get(0));\n\n        \/\/ Find each individual option\/statement in the question\n        var statements = jQuery(questionId + ' .ChoiceStructure li');\n\n        if (statements.length > 0) {\n            console.log(\"SUCCESS: Found \" + statements.length + \" statements to process.\");\n\n            statements.each(function() {\n                \/\/ Find the area within each statement to paste the labels into.\n                var inputContainer = jQuery(this).find('.Input, .InputCell'); \n                \n                if (inputContainer.length > 0) {\n                    var clonedLabels = topLabels.clone();\n                    inputContainer.append(clonedLabels);\n                    console.log(\"SUCCESS: Cloned and appended labels to a statement.\");\n                } else {\n                    console.error(\"ERROR: Could not find the '.Input' or '.InputCell' container inside a statement.\");\n                }\n            });\n\n            \/\/ Hide the original set of labels at the top\n            topLabels.first().hide();\n            console.log(\"SUCCESS: Script finished, original labels hidden.\");\n\n        } else {\n            console.error(\"ERROR: Could not find any statements to process. Looking for '.ChoiceStructure li'.\");\n        }\n    } else {\n        console.error(\"ERROR: Could not find the top labels container. Looking for '.SL-Labels' or '.SliderLabels'.\");\n    }\n});"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"Option B [name]'s place is great! It's in a lively neighborhood, with a bunch of places to eat ve...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Option B<\/strong><\/p>   <span style=\"background-color:#fffb8b; border-radius: 3px; padding: 2px 4px;\">[name]'s place is great<\/span>!  It's in a lively neighborhood, with a bunch of places to eat very close by.  Parking was never a problem, either.  The room was comfortable and they have Netflix in the room, which is a nice touch.  <span style=\"background-color:#fffb8b; border-radius: 3px; padding: 2px 4px;\">[name] and [name] are amazing hosts<\/span>, I'd definitely recommend staying with them!","DefaultChoices":false,"DataExportTag":"R1_B","QuestionID":"QID16","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":1,"CSSliderMax":7,"GridLines":6,"SnapToGrid":false,"NumDecimals":"0","ShowValue":false,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"Option B [name]'s place is great! It's in a lively neighborhood, with a bunch of places to eat ve...","Choices":{"4":{"Display":"To what extent did it capture ALL relevant text?"},"5":{"Display":"To what extent did it AVOID highlighting irrelevant text?"}},"ChoiceOrder":["4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":4,"Labels":{"1":{"Display":"Not at all"},"2":{"Display":"Moderately"},"3":{"Display":"Completely"}}}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"Please read the review carefully and look at the highlighted text. The highlighted parts are mean...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p style=\"font-size: 16px;\">Please read the review carefully and look at the <span style=\"background-color:#fffb8b;\">highlighted text<\/span>. The <span style=\"background-color:#fffb8b;\">highlighted parts<\/span> are meant to mark places where the review mentions a person (e.g., host, teacher) or describes their qualities, actions, or role,&nbsp; <strong>not those of the reviewer.<\/strong><\/p>\n\n<p style=\"font-size: 16px;\">Using the sliders below, rate how accurately <span style=\"background-color:#fffb8b;\">the highlights<\/span> capture these references to people.<\/p>\n\n<hr \/>\n<div style=\"padding:10px; border: 1px solid #ddd; background-color: #f9f9f9; border-radius: 5px; text-align: left; line-height: 1.6;\">\n<p><strong>Option A<\/strong><\/p>\n<span style=\"background-color:#fffb8b; border-radius: 3px; padding: 2px 4px;\">[name]&#39;s apartment is very well located, just a few blocks from the 6 train. The area is safe, with lots of restaurants (just one block from the famous J.G. Melon) and take away places (starbucks, pain quotidien, pick a bagel).<\/span> <span style=\"background-color:#fffb8b; border-radius: 3px; padding: 2px 4px;\">The apartment is small but cosy, perfect for one person or a couple. [name] couldn&#39;t be there, but her lovely parents were present to welcome me, despite the unsocial time I arrived. They were very nice and helpful<\/span>! I had a wonderful stay and would defenitly recommend this place.<\/div>","DefaultChoices":false,"QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":1,"CSSliderMax":7,"GridLines":6,"SnapToGrid":false,"NumDecimals":0,"ShowValue":false,"CustomStart":true,"NotApplicable":false,"MobileFirst":true,"SliderStartPositions":{"1":0.31073446327683618140014232267276383936405181884765625,"2":0}},"QuestionDescription":"Please read the review carefully and look at the highlighted text. The highlighted parts are mean...","Choices":{"5":{"Display":"To what extent did it capture ALL relevant text?"},"6":{"Display":"To what extent did it AVOID highlighting irrelevant text?"}},"ChoiceOrder":["5","6"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":6,"Labels":{"2":{"Display":"Not at all"},"3":{"Display":"Moderately"},"5":{"Display":"Completely"}},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    \n    console.log(\"Qualtrics Custom Slider Script: Starting for question \" + this.questionId);\n    \n    var questionId = '#' + this.questionId;\n    \n    \/\/ Let's try to find the top labels using a couple of common Qualtrics class names.\n    var topLabels = jQuery(questionId + ' .SL-Labels, ' + questionId + ' .SliderLabels');\n\n    if (topLabels.length > 0) {\n        console.log(\"SUCCESS: Found the top labels container.\", topLabels.get(0));\n\n        \/\/ Find each individual option\/statement in the question\n        var statements = jQuery(questionId + ' .ChoiceStructure li');\n\n        if (statements.length > 0) {\n            console.log(\"SUCCESS: Found \" + statements.length + \" statements to process.\");\n\n            statements.each(function() {\n                \/\/ Find the area within each statement to paste the labels into.\n                var inputContainer = jQuery(this).find('.Input, .InputCell'); \n                \n                if (inputContainer.length > 0) {\n                    var clonedLabels = topLabels.clone();\n                    inputContainer.append(clonedLabels);\n                    console.log(\"SUCCESS: Cloned and appended labels to a statement.\");\n                } else {\n                    console.error(\"ERROR: Could not find the '.Input' or '.InputCell' container inside a statement.\");\n                }\n            });\n\n            \/\/ Hide the original set of labels at the top\n            topLabels.first().hide();\n            console.log(\"SUCCESS: Script finished, original labels hidden.\");\n\n        } else {\n            console.error(\"ERROR: Could not find any statements to process. Looking for '.ChoiceStructure li'.\");\n        }\n    } else {\n        console.error(\"ERROR: Could not find the top labels container. Looking for '.SL-Labels' or '.SliderLabels'.\");\n    }\n});","QuestionText_Unsafe":"<p><mark>Please review the two options below and use the slider to rate the accuracy of the highlighting in each.<\/mark><\/p><hr> <div style=\"padding:10px; border: 1px solid #ddd; background-color: #f9f9f9; border-radius: 5px; text-align: left; line-height: 1.6;\">   <p><strong>Option A<\/strong><\/p>   [name]'s place is great!  It's in a lively neighborhood, with a bunch of places to eat very close by.  Parking was never a problem, either.  <span style='background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;'>The room was comfortable and they have Netflix in the room, which is a nice touch<\/span>.  [name] and [name] are amazing hosts, I'd definitely recommend staying with them! <\/div>\n","DataExportTag":"R2_A","QuestionID":"QID17"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID18","SecondaryAttribute":"Option B [name]'s apartment is very well located, just a few blocks from the 6 train. The area is...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"padding:10px; border: 1px solid #ddd; background-color: #f9f9f9; border-radius: 5px; text-align: left; line-height: 1.6;\">   <p><strong>Option B<\/strong><\/p>   <span style='background-color:#fffb8b; border-radius: 3px; padding: 2px 4px;'> [name]'s apartment is very well located, just a few blocks from the 6 train.<\/span> The area is safe, with lots of restaurants (just one block from the famous J.G. Melon) and take away places (starbucks, pain quotidien, pick a bagel).  The apartment is small but cosy, perfect for one person or a couple.  <span style='background-color:#fffb8b; border-radius: 3px; padding: 2px 4px;'> [name] couldn't be there, but her lovely parents were present to welcome me, despite the unsocial time I arrived.<\/span> <span style='background-color:#fffb8b; border-radius: 3px; padding: 2px 4px;'>They were very nice and helpful! I had a wonderful stay and would defenitly recommend this place.<\/span> <\/div>\n","DefaultChoices":false,"QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":