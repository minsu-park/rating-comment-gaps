tribute":"Preview Link","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"PreviewType":"Brand","PreviewID":"63832a52-370c-4951-abd9-e34321a71ce9"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"PROJ","PrimaryAttribute":"CORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"QC","PrimaryAttribute":"Survey Question Count","SecondaryAttribute":"28","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"RS","PrimaryAttribute":"RS_bEGTXPhOb2qLvOS","SecondaryAttribute":"Default Response Set","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DefaultMessage","Header":"","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":"","PreviousButton":"","NextButton":"","SurveyTitle":"Qualtrics Survey | Qualtrics Experience Management","SkinLibrary":"northwestern","SkinType":"templated","Skin":{"brandingId":"7225921912","templateId":"*base","overrides":null},"NewScoring":1,"SurveyMetaDescription":"The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today.","ProtectSelectionIds":true,"SurveyName":"Human_entity_identification","CustomStyles":{"customCSS":"\/* --- Qualtrics Slider Question Fix --- *\/\n\n\/* Target the container for the slider question statements *\/\n.Skin .Slider .ChoiceStructure {\n    display: block;\n}\n\n\/* Target the two \"cells\" that hold the label and the slider *\/\n.Skin .Slider .LabelCell, .Skin .Slider .InputCell {\n    \/* This is the key: force them to stack vertically instead of being side-by-side *\/\n    display: block;\n    \n    \/* Make them take up the full available width *\/\n    width: 100% !important; \n}\n\n\/* Add a bit of space below your highlighted text block for better separation *\/\n.Skin .Slider .LabelCell {\n    margin-bottom: 20px;\n}"}}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"Dear Participant, We invite you to join a short 8-minute study on how people evaluate text highli...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\">Dear Participant,<br \/>\n<br \/>\nWe invite you to join a short <strong>8-minute study<\/strong> on how people evaluate text highlights. You will earn <strong>$1.6 USD<\/strong> for completing the study.<br \/>\n<br \/>\nIn this study, you will read <strong>six (6) short reviews<\/strong>. For each review, you will see&nbsp;<b>two versions<\/b>&nbsp;with different parts of the text <span style=\"background-color:#fffb8b;\">highlighted.<\/span> These <span style=\"background-color:#fffb8b;\">highlights<\/span> were generated by two different approaches.<br \/>\n<br \/>\nThe goal of the <span style=\"background-color:#fffb8b;\">highlighting<\/span> is to&nbsp;<b>identify sentences that mention people<\/b>(e.g., Airbnb hosts, teachers) or&nbsp;<b>describe their qualities<\/b>.<br \/>\n<br \/>\nYour task is to&nbsp;<b>compare<\/b>&nbsp;the two options and&nbsp;<b>rate how accurate each option&rsquo;s highlighting is<\/b>.<\/span><br \/>\n<br \/>\n<span style=\"font-size:19px;\">Participation is voluntary, and you can withdraw at any time, but compensation is granted only after completing the survey. For questions, please contact:<\/span>\n<ul>\n\t<li><span style=\"font-size: 19px;\">Chao Yu, Northwestern University ([investigator email removed])<\/span><\/li>\n\t<li><span style=\"font-size: 19px;\">Minsu Park, New York University Abu Dhabi ([investigator email removed])<\/span><\/li>\n\t<li><span style=\"font-size: 19px;\">Hang Lu,&nbsp;University of Michigan ([investigator email removed])<\/span><\/li>\n<\/ul>\n&nbsp;\n\n<div style=\"text-align: center;\"><span style=\"font-size:19px;\"><span style=\"line-height:18.4px\"><span style=\"font-family:Aptos, sans-serif\"><span style=\"color:#000000\"><span style=\"font-style:normal\"><span style=\"font-weight:400\"><span style=\"white-space:normal\"><span style=\"text-decoration:none\"><strong>Statement of Consent<\/strong><\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/div>\n<span style=\"font-size:19px;\"><span style=\"line-height:18.4px\"><span style=\"font-family:Aptos, sans-serif\"><span style=\"color:#000000\"><span style=\"font-style:normal\"><span style=\"font-weight:400\"><span style=\"white-space:normal\"><span style=\"text-decoration:none\">I have read the above information, and agree to participate in this study.<\/span><\/span><\/span><\/span><\/span><\/span><\/span><\/span>","DefaultChoices":false,"DataExportTag":"Q1","QuestionID":"QID1","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Dear Participant, We invite you to join a short 8-minute study on how people evaluate text highli...","Choices":{"9":{"Display":"Yes, I consent to participate in this study."},"10":{"Display":"No, I do not consent to participate in this study."}},"ChoiceOrder":["9","10"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"Please review the two options below. Each option shows the review with a different set of sentenc...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Please review the two options below. Each option shows the review with a different set of sentences highlighted. <mark>The goal of the highlighting was to identify text that mentions human entities (e.g., hosts, instructors) or implies their qualities.<\/mark><\/p>\n<p><strong>Which option's highlighting is more accurate based on your judgment?<\/strong><\/p>\n<hr>\n<table style=\"width:100%; border-collapse: collapse;\">\n  <thead><tr style=\"text-align: center;\"><th style=\"width:50%; padding:10px; font-size:18px;\">Option A<\/th><th style=\"width:50%; padding:10px; font-size:18px;\">Option B<\/th><\/tr><\/thead>\n  <tbody>\n    <tr>\n      <td style=\"padding: 15px; vertical-align: top; border: 1px solid #ddd; background-color: #f9f9f9; line-height: 1.6;\">\n        <span style=\"background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;\">I had him for Statics<\/span>. <span style=\"background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;\">I started out with an A in his class for a month or so but my grade started to slip because I was being overwhelmed with the 4 other classes I had<\/span>. Mr. [name] is a really good teacher. He gives plenty of example problems on the board so we can understand what's going on. He provides his own scanned copies of his answer keys\n      <\/td>\n      <td style=\"padding: 15px; vertical-align: top; border: 1px solid #ddd; background-color: #f9f9f9; line-height: 1.6;\">\n        <span style=\"background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;\">I had him for Statics<\/span>. I started out with an A in his class for a month or so but my grade started to slip because I was being overwhelmed with the 4 other classes I had. Mr. [name] is a really good teacher. He gives plenty of example problems on the board so we can understand what'<span style=\"background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;\">s going on<\/span>. He provides his own scanned copies of his answer keys\n      <\/td>\n    <\/tr>\n  <\/tbody>\n<\/table>\n<p>&nbsp;<\/p>","DefaultChoices":false,"DataExportTag":"R5","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":1,"CSSliderMax":7,"GridLines":6,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"Please review the two options below. Each option shows the review with a different set of sentenc...","Choices":{"1":{"Display":"Option A"},"2":{"Display":"Option B"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":4,"Labels":{"3":{"Display":"<span style=\"font-size:16px;\">Very Inaccurate<\/span>"},"4":{"Display":"<span style=\"font-size:16px;\">Neutral<\/span>"},"5":{"Display":"<span style=\"font-size:16px;\">Very Accurate<\/span>"}},"QuestionID":"QID10","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n        \/\/ Hide the next button when the page loads\n        this.hideNextButton(); \n\n        \/\/ Set a timeout to show the next button after a delay (e.g., 5000 milliseconds for 5 seconds)\n        var delayTime = 5000; \/\/ Adjust this value for your desired delay in milliseconds\n\n        var that = this; \/\/ Store 'this' context for use inside setTimeout\n        setTimeout(function() {\n            that.showNextButton();\n        }, delayTime);\n    });"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"Please review the two options below. Each option shows the review with a different set of sentenc...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Please review the two options below. Each option shows the review with a different set of sentences highlighted. <mark>The goal of the highlighting was to identify text that mentions human entities (e.g., hosts, instructors) or implies their qualities.<\/mark><\/p>\n<p><strong>Which option's highlighting is more accurate based on your judgment?<\/strong><\/p>\n<hr>\n<table style=\"width:100%; border-collapse: collapse;\">\n  <thead><tr style=\"text-align: center;\"><th style=\"width:50%; padding:10px; font-size:18px;\">Option A<\/th><th style=\"width:50%; padding:10px; font-size:18px;\">Option B<\/th><\/tr><\/thead>\n  <tbody>\n    <tr>\n      <td style=\"padding: 15px; vertical-align: top; border: 1px solid #ddd; background-color: #f9f9f9; line-height: 1.6;\">\n        Pleasantly surprise.He has a very diverse way of teaching and making everyone feel equal am part of a group. Public speaking is one of the most unnerving and challenging tasks many of us dread. <span style=\"background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;\">This instructor has a relaxed yet structured and fair manner in his approach<\/span>. <span style=\"background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;\">I highly recommend him<\/span>.Got much more out of this class than expected.\n      <\/td>\n      <td style=\"padding: 15px; vertical-align: top; border: 1px solid #ddd; background-color: #f9f9f9; line-height: 1.6;\">\n        Pleasantly surprise.<span style=\"background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;\">He has a very diverse way of teaching and making everyone feel equal am part of a group<\/span>. Public speaking is one of the most unnerving and challenging tasks many of us dread. <span style=\"background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;\">This instructor has a relaxed yet structured and fair manner in his approach<\/span>. I highly recommend him.<span style=\"background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;\">Got much more out of this class than expected<\/span>.\n      <\/td>\n    <\/tr>\n  <\/tbody>\n<\/table>\n<p>&nbsp;<\/p>","DefaultChoices":false,"DataExportTag":"R4","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":1,"CSSliderMax":7,"GridLines":6,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"Please review the two options below. Each option shows the review with a different set of sentenc...","Choices":{"1":{"Display":"Option A"},"2":{"Display":"Option B"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":4,"Labels":{"3":{"Display":"<span style=\"font-size:16px;\">Very Inaccurate<\/span>"},"4":{"Display":"<span style=\"font-size:16px;\">Neutral<\/span>"},"5":{"Display":"<span style=\"font-size:16px;\">Very Accurate<\/span>"}},"QuestionID":"QID11","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n        \/\/ Hide the next button when the page loads\n        this.hideNextButton(); \n\n        \/\/ Set a timeout to show the next button after a delay (e.g., 5000 milliseconds for 5 seconds)\n        var delayTime = 5000; \/\/ Adjust this value for your desired delay in milliseconds\n\n        var that = this; \/\/ Store 'this' context for use inside setTimeout\n        setTimeout(function() {\n            that.showNextButton();\n        }, delayTime);\n    });"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"Debriefing Thank you for participating in our study! Your input has provided valuable insights in...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><strong>Debriefing<\/strong><\/span>\n<p><span style=\"font-size:19px;\">Thank you for participating in our study! Your input has provided valuable insights into how different methods&mdash;specifically dictionary-based and AI-based approaches&mdash;perform in detecting sentences that mention human entities (e.g., hosts, instructors).&nbsp;<\/span><\/p>\n\n<p><span style=\"font-size:19px;\">Your time and participation are greatly appreciated. If you have any questions, please contact Chao Yu at [investigator email removed].&nbsp;<br \/>\n<strong>Do you agree to submit your survey?<\/strong><\/span><\/p>","DefaultChoices":false,"DataExportTag":"Q12","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Debriefing Thank you for participating in our study! Your input has provided valuable insights in...","Choices":{"1":{"Display":"I agree, submit my responses."},"2":{"Display":"I disagree, withdraw my responses."}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID12"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q13","QuestionID":"QID13","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":15,"MaxSeconds":"0","ShowTimer":true},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":44,"NextAnswerId":1}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"Please review the two options below. Each option shows the review with a different set of sentenc...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Please review the two options below. Each option shows the review with a different set of sentences highlighted. <mark>The goal of the highlighting was to identify text that mentions human entities (e.g., hosts, instructors) or implies their qualities.<\/mark><\/p>\n<p><strong>Based on your judgment, how would you rate the accuracy of the highlighting in the text below?<\/strong><\/p><br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n        \/\/ Hide the next button when the page loads\n        this.hideNextButton(); \n\n        \/\/ Set a timeout to show the next button after a delay (e.g., 5000 milliseconds for 5 seconds)\n        var delayTime = 5000; \/\/ Adjust this value for your desired delay in milliseconds\n\n        var that = this; \/\/ Store 'this' context for use inside setTimeout\n        setTimeout(function() {\n            that.showNextButton();\n        }, delayTime);\n    });","DefaultChoices":false,"DataExportTag":"Q14","QuestionID":"QID14","QuestionType":"Matrix","Selector":"Likert","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true,"ChoiceColumnWidthPixels":550.5},"QuestionDescription":"Please review the two options below. Each option shows the review with a different set of sentenc...","Choices":{"1":{"Display":"<div style=\"padding:10px; border: 1px solid #ddd; background-color: #f9f9f9; border-radius: 5px; text-align: left; line-height: 1.6;\">   <p><strong>Option A<\/strong><\/p>   [name]'s place is great!  It's in a lively neighborhood, with a bunch of places to eat very close by.  Parking was never a problem, either.  <span style='background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;'>The room was comfortable and they have Netflix in the room, which is a nice touch<\/span>.  [name] and [name] are amazing hosts, I'd definitely recommend staying with them! <\/div>"},"2":{"Display":"<div style=\"padding:10px; border: 1px solid #ddd; background-color: #f9f9f9; border-radius: 5px; text-align: left; line-height: 1.6;\">   <p><strong>Option B<\/strong><\/p>   [name]'<span style='background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;'>s place is great<\/span>!  It's in a lively neighborhood, with a bunch of places to eat very close by.  Parking was never a problem, either.  The room was comfortable and they have Netflix in the room, which is a nice touch.  <span style='background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;'>[name] and [name] are amazing hosts, I<\/span>'d definitely recommend staying with them! <\/div>"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":10,"Answers":{"3":{"Display":"<span style=\"font-size:16px;\">Very Inaccurate<\/span>"},"6":{"Display":"<span style=\"font-size:16px;\">Inaccurate<\/span>"},"7":{"Display":"<span style=\"font-size:16px;\">Neutral<\/span>"},"8":{"Display":"<span style=\"font-size:16px;\">Accurate<\/span>"},"9":{"Display":"<span style=\"font-size:16px;\">Very Accurate<\/span>"}},"AnswerOrder":["3","6","7","8","9"],"ChoiceDataExportTags":false,"AnswerColumns":3,"SubSelector":"SingleAnswer"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"Please use the sliders below to evaluate each highlighting option. The goal was to identify menti...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><mark>Please use the sliders below to evaluate each highlighting option. The goal was to identify mentions of people (e.g., a host, an instructor) and their qualities.<\/mark><\/p><hr> <div style=\"padding:10px; border: 1px solid #ddd; background-color: #f9f9f9; border-radiu