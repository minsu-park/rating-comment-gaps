oking for '.SL-Labels' or '.SliderLabels'.\");\n    }\n});","QuestionText_Unsafe":"<p><mark>Please review the two options below and use the slider to rate the accuracy of the highlighting in each.<\/mark><\/p><hr> <div style=\"padding:10px; border: 1px solid #ddd; background-color: #f9f9f9; border-radius: 5px; text-align: left; line-height: 1.6;\">   <p><strong>Option A<\/strong><\/p>   <span style='background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;'>I had him for Statics<\/span>. <span style='background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;'>I started out with an A in his class for a month or so but my grade started to slip because I was being overwhelmed with the 4 other classes I had<\/span>.\\r \\r Mr. [name] is a really good teacher. He gives plenty of example problems on the board so we can understand what\\'s going on. He provides his own scanned copies of his answer keys <\/div>\n","DataExportTag":"R6_A","QuestionID":"QID25"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID26","SecondaryAttribute":"Option B Probably the worst teacher I have EVER had. I took him for bio 101, you would think it'd...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"padding:10px; border: 1px solid #ddd; background-color: #f9f9f9; border-radius: 5px; text-align: left; line-height: 1.6;\">   <p><strong>Option B<\/strong><\/p>   <span style='background-color:#fffb8b; border-radius: 3px; padding: 2px 4px;'>Probably the worst teacher I have EVER had.<\/span> I took him for bio 101, you would think it'd be easy. The average for the first two exams was a 65%. <span style='background-color:#fffb8b; border-radius: 3px; padding: 2px 4px;'>And to make things worst he whispers when he teachs, reads straight from the powerpoint and wears the same shark shirt everyday! NEVER TAKE HIS CLASSSS!<\/span> <\/div>\n","DefaultChoices":false,"QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":1,"CSSliderMax":7,"GridLines":6,"SnapToGrid":false,"NumDecimals":"0","ShowValue":false,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"Option B Probably the worst teacher I have EVER had. I took him for bio 101, you would think it'd...","Choices":{"4":{"Display":"To what extent did it capture ALL relevant text?"},"5":{"Display":"To what extent did it AVOID highlighting irrelevant text?"}},"ChoiceOrder":["4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":4,"Labels":{"1":{"Display":"Not at all"},"2":{"Display":"Moderately"},"3":{"Display":"Completely"}},"QuestionText_Unsafe":"<div style=\"padding:10px; border: 1px solid #ddd; background-color: #f9f9f9; border-radius: 5px; text-align: left; line-height: 1.6;\">   <p><strong>Option B<\/strong><\/p>   <span style='background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;'>I had him for Statics<\/span>. I started out with an A in his class for a month or so but my grade started to slip because I was being overwhelmed with the 4 other classes I had.\\r \\r Mr. [name] is a really good teacher. He gives plenty of example problems on the board so we can understand what\\'<span style='background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;'>s going on<\/span>. He provides his own scanned copies of his answer keys <\/div>\n","DataExportTag":"R6_B","QuestionID":"QID26"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID27","SecondaryAttribute":"What is your Prolific ID?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your Prolific ID?","DefaultChoices":false,"DataExportTag":"Q27","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":645,"InputHeight":29},"QuestionDescription":"What is your Prolific ID?","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID27"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID28","SecondaryAttribute":"Please read the review carefully and look at the highlighted text. The highlighted parts are mean...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p style=\"font-size: 16px;\">Please read the review carefully and look at the <span style=\"background-color:#fffb8b;\">highlighted text<\/span>. The <span style=\"background-color:#fffb8b;\">highlighted parts<\/span> are meant to mark places where the review mentions a person (e.g., host, teacher) or describes their qualities, actions, or roles, <strong>not those of the reviewer.<\/strong><\/p>\n\n<p style=\"font-size: 16px;\">Using the sliders below, rate how accurately <span style=\"background-color:#fffb8b;\">the highlights<\/span> capture these references to people.<\/p>\n\n<hr>\n<div style=\"padding:10px; border: 1px solid #ddd; background-color: #f9f9f9; border-radius: 5px; text-align: left; line-height: 1.6;\">\n<p><strong>Option A<\/strong><\/p>\n<span style=\"background-color:#fffb8b; border-radius: 3px; padding: 2px 4px;\">[name]'s place is great<\/span>! It's in a lively neighborhood, with a bunch of places to eat very close by. Parking was never a problem, either. <span style=\"background-color:#fffb8b; border-radius: 3px; padding: 2px 4px;\">The room was comfortable and they have Netflix in the room, which is a nice touch<\/span>. [name] and [name] are amazing hosts, I'd definitely recommend staying with them!<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    \n    console.log(\"Qualtrics Custom Slider Script: Starting for question \" + this.questionId);\n    \n    var questionId = '#' + this.questionId;\n    \n    \/\/ Let's try to find the top labels using a couple of common Qualtrics class names.\n    var topLabels = jQuery(questionId + ' .SL-Labels, ' + questionId + ' .SliderLabels');\n\n    if (topLabels.length > 0) {\n        console.log(\"SUCCESS: Found the top labels container.\", topLabels.get(0));\n\n        \/\/ Find each individual option\/statement in the question\n        var statements = jQuery(questionId + ' .ChoiceStructure li');\n\n        if (statements.length > 0) {\n            console.log(\"SUCCESS: Found \" + statements.length + \" statements to process.\");\n\n            statements.each(function() {\n                \/\/ Find the area within each statement to paste the labels into.\n                var inputContainer = jQuery(this).find('.Input, .InputCell'); \n                \n                if (inputContainer.length > 0) {\n                    var clonedLabels = topLabels.clone();\n                    inputContainer.append(clonedLabels);\n                    console.log(\"SUCCESS: Cloned and appended labels to a statement.\");\n                } else {\n                    console.error(\"ERROR: Could not find the '.Input' or '.InputCell' container inside a statement.\");\n                }\n            });\n\n            \/\/ Hide the original set of labels at the top\n            topLabels.first().hide();\n            console.log(\"SUCCESS: Script finished, original labels hidden.\");\n\n        } else {\n            console.error(\"ERROR: Could not find any statements to process. Looking for '.ChoiceStructure li'.\");\n        }\n    } else {\n        console.error(\"ERROR: Could not find the top labels container. Looking for '.SL-Labels' or '.SliderLabels'.\");\n    }\n});","DefaultChoices":false,"DataExportTag":"R1_A","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":1,"CSSliderMax":7,"GridLines":6,"SnapToGrid":false,"NumDecimals":0,"ShowValue":false,"CustomStart":true,"SliderStartPositions":{"1":0.31073446327683618140014232267276383936405181884765625,"2":0},"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"Please read the review carefully and look at the highlighted text. The highlighted parts are mean...","Choices":{"5":{"Display":"To what extent did it capture ALL relevant text?"},"6":{"Display":"To what extent did it AVOID highlighting irrelevant text?"}},"ChoiceOrder":["5","6"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":6,"Labels":{"2":{"Display":"Not at all"},"3":{"Display":"Moderately"},"5":{"Display":"Completely"}},"QuestionID":"QID28"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q3","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":5,"MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":132,"NextAnswerId":1,"QuestionID":"QID3"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"Please carefully read the original review below and choose the task results in the multiple choic...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please carefully read the original review below and choose the task results in the multiple choice options that does the best in identifying sentences that mention human entities (e.g., hosts, instructors) based on your judgement.<br>Original Review:\n<br>We had a great time at Maggie\u2018s place! Not just her apartment is really cozy, cute and clean, but Maggie is such a great host who definitely enriched our stay. Maggie is super cute, kind and funny and cares about her guests and tries her best to make them feel comfortable! The place is super close to the Subway which takes you directly to Manhatten and around it are many shops and restaurants! \nA great place to stay.","DefaultChoices":false,"DataExportTag":"Review 1 ","QuestionID":"QID4","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please carefully read the original review below and choose the task results in the multiple choic...","Choices":{"4":{"Display":"Not just her apartment is really cozy, cute and clean, but Maggie is such a great host who definitely enriched our stay. Baggie is super cute, kind and funny and cares about her guests and tries her best to make them feel comfortable!"},"7":{"Display":"We had a great time at host\u2018s place!, not just her apartment is really cozy, cute and clean, but host is such a great host who definitely enriched our stay., host is super cute, kind and funny and cares about her guests and tries her best to make them feel comfortable!, the place is super close to the subway which takes you directly to manhatten and around it are many shops and restaurants!"}},"ChoiceOrder":["4","7"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"Please carefully read the original review above and choose the task results below that does the b...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please carefully read the original review above and choose the task results below that does the best in identifying sentences that mention human entities (e.g., hosts, instructors) based on your judgement.","DefaultChoices":false,"DataExportTag":"Instruction","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please carefully read the original review above and choose the task results below that does the b...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID5"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"Please review the two options below. Each option shows the review with a different set of sentenc...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Please review the two options below. Each option shows the review with a different set of sentences highlighted. <mark>The goal of the highlighting was to identify text that mentions human entities (e.g., hosts, instructors) or implies their qualities.<\/mark><\/p>\n<p><strong>Based on your judgment, how would you rate the accuracy of the highlighting in the text below?<\/strong><\/p>\n<hr>\n<table style=\"width:100%; border-collapse: collapse;\">\n  <thead><tr style=\"text-align: center;\"><th style=\"width:50%; padding:10px; font-size:18px;\">Option A<\/th><th style=\"width:50%; padding:10px; font-size:18px;\">Option B<\/th><\/tr><\/thead>\n  <tbody>\n    <tr>\n      <td style=\"padding: 15px; vertical-align: top; border: 1px solid #ddd; background-color: #f9f9f9; line-height: 1.6;\">\n        [name]'<span style=\"background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;\">s place is great<\/span>!  It's in a lively neighborhood, with a bunch of places to eat very close by.  Parking was never a problem, either.  The room was comfortable and they have Netflix in the room, which is a nice touch.  <span style=\"background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;\">[name] and [name] are amazing hosts, I<\/span>'d definitely recommend staying with them!\n      <\/td>\n      <td style=\"padding: 15px; vertical-align: top; border: 1px solid #ddd; background-color: #f9f9f9; line-height: 1.6;\">\n        [name]'s place is great!  It's in a lively neighborhood, with a bunch of places to eat very close by.  Parking was never a problem, either.  <span style=\"background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;\">The room was comfortable and they have Netflix in the room, which is a nice touch<\/span>.  [name] and [name] are amazing hosts, I'd definitely recommend staying with them!\n      <\/td>\n    <\/tr>\n  <\/tbody>\n<\/table>\n<p>&nbsp;<\/p>","DefaultChoices":false,"DataExportTag":"R1","QuestionID":"QID6","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","CSSliderMin":1,"CSSliderMax":7,"GridLines":6,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"Please review the two options below. Each option shows the review with a different set of sentenc...","Choices":{"1":{"Display":"Option A"},"2":{"Display":"Option B"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":4,"Labels":{"3":{"Display":"<span style=\"font-size:16px;\">Very Inaccurate<\/span>"},"4":{"Display":"<span style=\"font-size:16px;\">Neutral<\/span>"},"5":{"Display":"<span style=\"font-size:16px;\">Very Accurate<\/span>"}},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n        \/\/ Hide the next button when the page loads\n        this.hideNextButton(); \n\n        \/\/ Set a timeout to show the next button after a delay (e.g., 5000 milliseconds for 5 seconds)\n        var delayTime = 5000; \/\/ Adjust this value for your desired delay in milliseconds\n\n        var that = this; \/\/ Store 'this' context for use inside setTimeout\n        setTimeout(function() {\n            that.showNextButton();\n        }, delayTime);\n    });"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"Please review the two options below. Each option shows the review with a different set of sentenc...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Please review the two options below. Each option shows the review with a different set of sentences highlighted. <mark>The goal of the highlighting was to identify text that mentions human entities (e.g., hosts, instructors) or implies their qualities.<\/mark><\/p>\n<p><strong>Which option's highlighting is more accurate based on your judgment?<\/strong><\/p>\n<hr>\n<table style=\"width:100%; border-collapse: collapse;\">\n  <thead><tr style=\"text-align: center;\"><th style=\"width:50%; padding:10px; font-size:18px;\">Option A<\/th><th style=\"width:50%; padding:10px; font-size:18px;\">Option B<\/th><\/tr><\/thead>\n  <tbody>\n    <tr>\n      <td style=\"padding: 15px; vertical-align: top; border: 1px solid #ddd; background-color: #f9f9f9; line-height: 1.6;\">\n        [name]'s apartment is very well located, just a few blocks from the 6 train. The area is safe, with lots of restaurants (just one block from the famous J.G. <span style=\"background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;\">Melon) and take away places (starbucks, pain quotidien, pick a bagel<\/span>). \n<span style=\"background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;\">The apartment is small but cosy, perfect for one person or a couple<\/span>. \n[name] couldn't be there, but her lovely parents were present to welcome me, despite the unsocial time I arrived. <span style=\"background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;\">They were very nice and helpful<\/span>! I had a wonderful stay and would defenitly recommend this place.\n      <\/td>\n      <td style=\"padding: 15px; vertical-align: top; border: 1px solid #ddd; background-color: #f9f9f9; line-height: 1.6;\">\n        [name]'s apartment is very well located, just a few blocks from the 6 train. The area is safe, with lots of restaurants (just one block from the famous J.G. Melon) and take away places (starbucks, pain quotidien, pick a bagel). \nThe apartment is small but cosy, perfect for one person or a couple. \n[name] couldn't be there, but her lovely parents were present to welcome me, despite the unsocial time I arrived. <span style=\"background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;\">They were very nice and helpful<\/span>! I had a wonderful stay and would defenitly recommend this place.\n      <\/td>\n    <\/tr>\n  <\/tbody>\n<\/table>\n<p>&nbsp;<\/p>","DefaultChoices":false,"DataExportTag":"R2 ","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":1,"CSSliderMax":7,"GridLines":6,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"Please review the two options below. Each option shows the review with a different set of sentenc...","Choices":{"1":{"Display":"Option A"},"2":{"Display":"Option B"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":4,"Labels":{"3":{"Display":"<span style=\"font-size:16px;\">Very Inaccurate<\/span>"},"4":{"Display":"<span style=\"font-size:16px;\">Neutral<\/span>"},"5":{"Display":"<span style=\"font-size:16px;\">Very Accurate<\/span>"}},"QuestionID":"QID7","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n        \/\/ Hide the next button when the page loads\n        this.hideNextButton(); \n\n        \/\/ Set a timeout to show the next button after a delay (e.g., 5000 milliseconds for 5 seconds)\n        var delayTime = 5000; \/\/ Adjust this value for your desired delay in milliseconds\n\n        var that = this; \/\/ Store 'this' context for use inside setTimeout\n        setTimeout(function() {\n            that.showNextButton();\n        }, delayTime);\n    });"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Please review the two options below. Each option shows the review with a different set of sentenc...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Please review the two options below. Each option shows the review with a different set of sentences highlighted. <mark>The goal of the highlighting was to identify text that mentions human entities (e.g., hosts, instructors) or implies their qualities.<\/mark><\/p>\n<p><strong>Which option's highlighting is more accurate based on your judgment?<\/strong><\/p>\n<hr>\n<table style=\"width:100%; border-collapse: collapse;\">\n  <thead><tr style=\"text-align: center;\"><th style=\"width:50%; padding:10px; font-size:18px;\">Option A<\/th><th style=\"width:50%; padding:10px; font-size:18px;\">Option B<\/th><\/tr><\/thead>\n  <tbody>\n    <tr>\n      <td style=\"padding: 15px; vertical-align: top; border: 1px solid #ddd; background-color: #f9f9f9; line-height: 1.6;\">\n        <span style=\"background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;\">I was a bit busy the whole time that i was there so i didnt have much time to bond with the host, but the time that i did spend in the apt<\/span>. was lovely. I have nothing negative to say. I think this place is wonderful, clean, and quite. \n      <\/td>\n      <td style=\"padding: 15px; vertical-align: top; border: 1px solid #ddd; background-color: #f9f9f9; line-height: 1.6;\">\n        I was a bit busy the whole time that i was there so i didnt have much time to bond with the host, but the time that i did spend in the apt. <span style=\"background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;\">was lovely<\/span>. I have nothing negative to say. <span style=\"background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;\">I think this place is wonderful, clean, and quite<\/span>. \n      <\/td>\n    <\/tr>\n  <\/tbody>\n<\/table>\n<p>&nbsp;<\/p>","DefaultChoices":false,"DataExportTag":"R3 ","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":1,"CSSliderMax":7,"GridLines":6,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"Please review the two options below. Each option shows the review with a different set of sentenc...","Choices":{"1":{"Display":"Option A"},"2":{"Display":"Option B"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":4,"Labels":{"3":{"Display":"<span style=\"font-size:16px;\">Very Inaccurate<\/span>"},"4":{"Display":"<span style=\"font-size:16px;\">Neutral<\/span>"},"5":{"Display":"<span style=\"font-size:16px;\">Very Accurate<\/span>"}},"QuestionID":"QID8","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n        \/\/ Hide the next button when the page loads\n        this.hideNextButton(); \n\n        \/\/ Set a timeout to show the next button after a delay (e.g., 5000 milliseconds for 5 seconds)\n        var delayTime = 5000; \/\/ Adjust this value for your desired delay in milliseconds\n\n        var that = this; \/\/ Store 'this' context for use inside setTimeout\n        setTimeout(function() {\n            that.showNextButton();\n        }, delayTime);\n    });"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":"Please review the two options below. Each option shows the review with a different set of sentenc...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Please review the two options below. Each option shows the review with a different set of sentences highlighted. <mark>The goal of the highlighting was to identify text that mentions human entities (e.g., hosts, instructors) or implies their qualities.<\/mark><\/p>\n<p><strong>Which option's highlighting is more accurate based on your judgment?<\/strong><\/p>\n<hr>\n<table style=\"width:100%; border-collapse: collapse;\">\n  <thead><tr style=\"text-align: center;\"><th style=\"width:50%; padding:10px; font-size:18px;\">Option A<\/th><th style=\"width:50%; padding:10px; font-size:18px;\">Option B<\/th><\/tr><\/thead>\n  <tbody>\n    <tr>\n      <td style=\"padding: 15px; vertical-align: top; border: 1px solid #ddd; background-color: #f9f9f9; line-height: 1.6;\">\n        <span style=\"background-color:#d1ecf1; border-radius: 3px; padding: 2px 4px;\">Probably the worst teacher I have EVER had<\/span>. I took him for bio 101, you would think it'd be easy. The average for the first two exams was a 65%. And to make things worst he whispers when he teachs, reads straight from the powerpoint and wears the same shark shirt everyday! NEVER TAKE HIS CLASSSS!\n      <\/td>\n      <td style=\"padding: 15px; vertical-align: top; border: 1px solid #ddd; background-color: #f9f9f9; line-height: 1.6;\">\n        Probably the worst teacher I have EVER had. I took him for bio 101, you would think it'd be easy. <span style=\"background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;\">The average for the first two exams was a 65<\/span>%. <span style=\"background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;\">And to make things worst he whispers when he teachs, reads straight from the powerpoint and wears the same shark shirt everyday<\/span>! <span style=\"background-color:#f8d7da; border-radius: 3px; padding: 2px 4px;\">NEVER TAKE HIS CLASSSS<\/span>!\n      <\/td>\n    <\/tr>\n  <\/tbody>\n<\/table>\n<p>&nbsp;<\/p>","DefaultChoices":false,"DataExportTag":"R6","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":1,"CSSliderMax":7,"GridLines":6,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"Please review the two options below. Each option shows the review with a different set of sentenc...","Choices":{"1":{"Display":"Option A"},"2":{"Display":"Option B"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":4,"Labels":{"3":{"Display":"<span style=\"font-size:16px;\">Very Inaccurate<\/span>"},"4":{"Display":"<span style=\"font-size:16px;\">Neutral<\/span>"},"5":{"Display":"<span style=\"font-size:16px;\">Very Accurate<\/span>"}},"QuestionID":"QID9","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n        \/\/ Hide the next button when the page loads\n        this.hideNextButton(); \n\n        \/\/ Set a timeout to show the next button after a delay (e.g., 5000 milliseconds for 5 seconds)\n        var delayTime = 5000; \/\/ Adjust this value for your desired delay in milliseconds\n\n        var that = this; \/\/ Store 'this' context for use inside setTimeout\n        setTimeout(function() {\n            that.showNextButton();\n        }, delayTime);\n    });"}},{"SurveyID":"SV_03d6DHX0CTW9l8W","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}